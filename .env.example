# Copia questo file in .env e compila i valori dal tuo progetto Firebase
# Firebase Console → Impostazioni progetto → Le tue app → Web → Configurazione SDK

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# VAPID key per Web Push (notifiche push)
# Firebase Console → Impostazioni progetto → Cloud Messaging → Certificati Web Push
# → Genera coppia di chiavi → copia il valore "Coppia di chiavi"
VITE_FIREBASE_VAPID_KEY=

# Modalità demo (utente finto + dati di esempio, senza Firebase)
# Su Vercel si attiva da sola per ogni branch diverso da master (mai in produzione).
# In locale: true per attivarla, false per forzare il login Google anche su un branch non-master.
# VITE_MOCK_MODE=true
